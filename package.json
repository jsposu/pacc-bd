{
  "name": "pacc-bd",
  "private": true,
  "version": "2.0.0",
  "license": "MIT",
  "description": "Local osu! Collector and tournament beatmap downloader for Panama Accuracy",
  "homepage": "https://github.com/jsposu/pacc-bd",
  "author": { "name": "osakari", "email": "jsposu@users.noreply.github.com" },
  "desktopName": "PACC-BD",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx server/index.ts",
    "build": "vite build && tsc --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "build:all": "npm run build && npm run build:server",
    "desktop": "npm run build:all && electron .",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win nsis --publish never",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.5",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "yazl": "^3.3.1"
  }
}
